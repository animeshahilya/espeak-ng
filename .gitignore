# Android-only fork: this file intentionally covers just the Android app,
# the NDK/host CMake builds, and generated voice-data intermediates.
# Desktop ports (Windows, emscripten), docs, vim/nano syntax files, the
# desktop test suite, and autotools support were removed upstream of this
# branch, so their ignore patterns were dropped here too.

# editor/external files:

*~
.*.swp
*.bat

# OS metadata files:

.DS_Store

# Eclipse project files:

.autotools
.cproject
.project
.settings

# VSCode project files:
.vscode

# intermediate build output:

*.o
*.lo

# android build output:

bin/
obj/
gen/
android/icons/*.png

libttsespeak.so

android/res/raw/espeakdata.zip
android/res/raw/espeakdata_version

local.properties

# android gradle output:
.cxx
.gradle/
.idea/
build*/
*.iml
!gradlew.bat

# android release signing - never commit the keystore or its credentials:
android/keystore.properties
*.jks
*.keystore

# compiled library artifacts:

libespeak-ng.a
libespeak-ng.la
libespeak-ng.so*

# host data-compiler binary and packaging artifacts:

src/espeak-ng

espeak-ng.pc

espeak-ng-*.tar.gz
espeak-ng-*.*/

# espeak-ng-data (generated voice data intermediates - the sources in
# dictsource/, phsource/, and espeak-ng-data/lang|voices stay tracked):

dictsource/*_extra
dictsource/dict_log
dictsource/dict_phonemes
dictsource/ru_listx
dictsource/cmn_listx
dictsource/yue_listx

phsource/compile_prog_log
phsource/compile_report
phsource/error_intonation
phsource/error_log
phsource/phonemes.stamp

espeak-ng-data/config
espeak-ng-data/dictsource
espeak-ng-data/phsource
espeak-ng-data/*_dict
espeak-ng-data/intonations
espeak-ng-data/phondata
espeak-ng-data/phondata-manifest
espeak-ng-data/phonindex
espeak-ng-data/phontab
