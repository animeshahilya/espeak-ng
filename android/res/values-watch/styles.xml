<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as NoActionBar (windowActionBar=false + windowNoTitle=true) but
         inheriting AppTheme.Base so the brand colors still apply on watches. -->
    <style name="AppTheme" parent="AppTheme.Base">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
