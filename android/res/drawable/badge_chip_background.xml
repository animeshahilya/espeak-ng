<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- M3 assist-chip look: 8dp radius with a subtle outline. The fill and
         text colors stay the semantic per-usage ones from colors.xml. -->
    <corners android:radius="8dp" />
    <solid android:color="@color/chip_bg_section" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
</shape>
