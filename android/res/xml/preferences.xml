<?xml version="1.0" encoding="utf-8"?>
<!-- The settings screen, laid out like iOS Settings: the three things people
     change most on the first page, then one page per topic. TtsSettingsActivity
     inflates this once the engine has loaded, then fills in what needs the
     engine (voice parameters, the language list) and drops the rows marked
     "not on Wear" on a watch. Keys must match the constants in VoiceSettings.
     Rows inside a page have no icons (iconSpaceReserved off), so their text
     lines up; every row on the first page has one. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory
      android:title="@string/category_voice">
    <com.animeshahilya.espeakng.preference.VoiceVariantPreference
        android:key="espeak_variant"
        android:title="@string/espeak_variant"
        android:icon="@drawable/ic_record_voice_over" />
    <com.animeshahilya.espeakng.preference.SeekBarPreference
        android:key="espeak_rate"
        android:title="@string/setting_default_rate"
        android:icon="@drawable/ic_speed" />
    <!-- not on Wear. Natural (Piper) voices: per-language choice between
         eSpeak and a downloaded neural voice. PiperSettings fills in the
         per-language rows and the download/manage actions. -->
    <PreferenceScreen
        android:key="sub_natural_voices"
        android:title="@string/screen_natural_voices_title"
        android:summary="@string/screen_natural_voices_summary"
        android:icon="@drawable/ic_graphic_eq">
      <!-- Off means off: nothing natural-voice is loaded (TtsService frees
           loaded models on the switch) and the rows that only matter while
           on are disabled. Voices stay manageable, to free the space. -->
      <com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory
          android:key="category_piper_master"
          android:title="@string/category_piper_master"
          app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="piper_enabled"
            android:title="@string/setting_piper_enabled"
            android:summaryOn="@string/setting_piper_enabled_summary_on"
            android:summaryOff="@string/setting_piper_enabled_summary_off"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
      </com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory>
      <com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory
          android:key="category_piper_languages"
          android:title="@string/category_piper_languages"
          android:dependency="piper_enabled"
          app:iconSpaceReserved="false" />
      <com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory
          android:key="category_piper_voices"
          android:title="@string/category_piper_voices"
          app:iconSpaceReserved="false">
        <Preference
            android:key="action_piper_download"
            android:title="@string/setting_piper_download"
            android:summary="@string/setting_piper_download_summary"
            android:dependency="piper_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="action_piper_snapdragon"
            android:title="@string/setting_piper_snapdragon"
            android:summary="@string/setting_piper_snapdragon_summary"
            android:dependency="piper_enabled"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="action_piper_manage"
            android:title="@string/setting_piper_manage"
            app:iconSpaceReserved="false" />
      </com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory>
      <com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory
          android:title="@string/category_piper_screen_reader"
          android:dependency="piper_enabled"
          app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="piper_espeak_for_characters"
            android:title="@string/setting_piper_espeak_for_characters"
            android:summary="@string/setting_piper_espeak_for_characters_summary"
            android:summaryOn="@string/setting_piper_espeak_for_characters_summary_on"
            android:summaryOff="@string/setting_piper_espeak_for_characters_summary_off"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="piper_speed"
            android:title="@string/setting_piper_speed"
            android:entries="@array/piper_speed_entries"
            android:entryValues="@array/piper_speed_values"
            android:defaultValue="100"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="piper_style"
            android:title="@string/setting_piper_style"
            android:entries="@array/piper_style_entries"
            android:entryValues="@array/piper_style_values"
            android:defaultValue="natural"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
      </com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory>
    </PreferenceScreen>
    <!-- not on Wear -->
    <Preference
        android:key="action_test_voice"
        android:title="@string/test_voice_title"
        android:summary="@string/test_voice_summary"
        android:icon="@drawable/ic_play_circle" />
  </com.animeshahilya.espeakng.preference.AccessiblePreferenceCategory>

