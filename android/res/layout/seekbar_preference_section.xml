<?xml version="1.0" encoding="utf-8"?>
<!-- One voice parameter: its name, its current value, the slider and the
     controls that go with it. Inflated once per parameter by
     SeekBarPreference. Every height is wrap_content: the sections live in a
     ScrollView, so weights would collapse them to nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding_h"
    android:paddingEnd="@dimen/dialog_padding_h"
    android:paddingTop="@dimen/section_gap"
    android:paddingBottom="@dimen/section_gap" >

    <!-- Parameter title -->
    <TextView
        android:id="@+id/parameterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/parameter_bezel_inset"
        android:layout_marginEnd="@dimen/parameter_bezel_inset"
        android:layout_marginBottom="4dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:importantForAccessibility="no" />

    <!-- SeekBarPreference writes the same string here and into the slider's
         content description, so leaving this label in the accessibility tree
         would announce every parameter twice. The slider is the thing you
         operate, so it keeps the announcement and this label is skipped. -->
    <TextView
        android:id="@+id/valueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/parameter_bezel_inset"
        android:layout_marginEnd="@dimen/parameter_bezel_inset"
        android:layout_marginBottom="4dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorPrimary" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="@dimen/parameter_bezel_inset"
        android:layout_marginEnd="@dimen/parameter_bezel_inset"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_thumb"
        android:progressBackgroundTint="?attr/colorSurfaceContainerHighest"
        android:progressTint="?attr/colorPrimary"
        android:thumbTint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical" >

        <!-- Only the speech rate shows this; SeekBarPreference hides it for
             every other parameter, and the gravity above keeps the reset
             button at the end either way. -->
        <CheckBox
            android:id="@+id/rateBoost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/setting_rate_boost"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:buttonTint="?attr/colorPrimary" />

        <!-- Text button: a filled Reset competes with the sliders for
             attention and with OK for the primary-action role. -->
        <Button
            android:id="@+id/resetToDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/resetToDefault"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>

</LinearLayout>