<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom">

    <!-- Search field with floating hint -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_gap"
        android:hint="@string/languages_search_hint"
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        app:endIconContentDescription="@string/clear_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/languages_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textFilter"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Match/selection counter as a subtle badge -->
    <TextView
        android:id="@+id/languages_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_gap"
        android:paddingStart="@dimen/tight_gap"
        android:paddingEnd="@dimen/tight_gap"
        android:paddingTop="@dimen/chip_pad_v"
        android:paddingBottom="@dimen/chip_pad_v"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:background="@drawable/badge_chip_background"
        android:accessibilityLiveRegion="polite" />

    <!-- Language list with custom styled items -->
    <ListView
        android:id="@+id/supported_languages_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice"
        android:divider="@null"
        android:listSelector="@drawable/list_item_selector"
        android:paddingTop="@dimen/tight_gap"
        android:paddingBottom="@dimen/tight_gap" />

    <!-- Bulk action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/section_gap"
        android:paddingTop="@dimen/content_gap"
        android:background="@drawable/divider_top">

        <Button
            android:id="@+id/button_select_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/tight_gap"
            android:text="@string/espeak_select_all_languages"
            style="?attr/materialButtonTonalStyle" />

        <Button
            android:id="@+id/button_deselect_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tight_gap"
            android:text="@string/espeak_deselect_all_languages"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>

</LinearLayout>