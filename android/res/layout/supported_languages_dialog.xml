<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom">

    <!-- Floating hint names the field to TalkBack; built-in clear-text end
         icon replaces the old standalone clear button. endIconContentDescription
         localizes what TalkBack says when swiping to the clear affordance
         (the framework default is the English-only "Clear text"). -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_gap"
        android:hint="@string/languages_search_hint"
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        app:endIconContentDescription="@string/clear_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/languages_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textFilter"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Match/selection counter: a polite live region, so bulk Select all /
         Deselect all and search filtering both reach TalkBack. -->
    <TextView
        android:id="@+id/languages_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_gap"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:accessibilityLiveRegion="polite" />

    <ListView
        android:id="@+id/supported_languages_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="multipleChoice"
        android:divider="?attr/colorOutlineVariant"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/section_gap">

        <!-- Primary bulk action: tonal. Deselect is secondary: outlined. -->
        <Button
            android:id="@+id/button_select_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/espeak_select_all_languages"
            style="?attr/materialButtonTonalStyle" />

        <Space
            android:layout_width="@dimen/section_gap"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button_deselect_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/espeak_deselect_all_languages"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

</LinearLayout>
