<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp" >

    <!-- Animated icon container -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="?attr/colorPrimaryContainer"
        android:elevation="4dp"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_language"
            android:tint="?attr/colorPrimary"
            android:importantForAccessibility="no"
            android:contentDescription="@string/installing_voice_data" />

    </FrameLayout>

    <!-- Status text with live region -->
    <TextView
        android:id="@+id/installing_voice_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:text="@string/installing_voice_data" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="@string/installing_voice_data_subtitle" />

    <!-- M3 indeterminate indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:importantForAccessibility="no"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorPrimaryContainer"
        app:trackThickness="4dp"
        app:indicatorSize="48dp" />

</LinearLayout>