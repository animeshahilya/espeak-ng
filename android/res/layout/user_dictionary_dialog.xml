<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingBottom="@dimen/dialog_padding_bottom">

    <!-- Floating hint + built-in clear-text end icon; the localized end-icon
         description keeps TalkBack from falling back to English "Clear text". -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:hint="@string/dict_search_hint"
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        app:endIconContentDescription="@string/clear_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dict_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Section filter as an M3 exposed dropdown: same outlined field shape
         as the search box above, and TalkBack announces it as a dropdown. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dict_filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_gap"
        android:hint="@string/dict_filter_label"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/dict_filter_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="none"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Live match count status -->
    <TextView
        android:id="@+id/dict_rules_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/content_gap"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:accessibilityLiveRegion="polite" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp">

        <ListView
            android:id="@+id/dict_rules_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/colorOutlineVariant"
            android:dividerHeight="1dp" />

        <!-- Empty state is a polite live region: switching to "no rules" or
             "no match" reaches TalkBack without a swipe hunt. -->
        <TextView
            android:id="@+id/dict_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
