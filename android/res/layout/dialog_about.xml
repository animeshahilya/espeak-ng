<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="@dimen/screen_padding">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/about_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/icon"
            android:importantForAccessibility="no" />

        <!-- App Title: a TalkBack heading (API 28+) so swipe-down jumps here. -->
        <TextView
            android:id="@+id/about_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <!-- Version & Offline Badge -->
        <TextView
            android:id="@+id/about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:background="@drawable/badge_chip_background"
            android:textColor="@color/chip_text_section" />

        <!-- Developer Credit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/about_developer"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Highlights Header: heading for TalkBack swipe-down navigation. -->
        <TextView
            android:id="@+id/about_features_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/about_features_header"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- Feature highlights: one view, one TalkBack stop. The text is
             joined from the individual about_feature_* strings in
             TtsSettingsActivity.showAboutDialog() so each line stays
             independently translatable. -->
        <TextView
            android:id="@+id/about_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- License Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/about_license"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- GitHub Button: outlined (the positive OK button already owns the
             filled/tonal primary slot in the dialog footer). -->
        <Button
            android:id="@+id/btn_about_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:minWidth="140dp"
            android:text="@string/about_view_github"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>
