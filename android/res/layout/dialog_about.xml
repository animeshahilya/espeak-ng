<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:paddingBottom="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp">

        <!-- App Icon with Material 3 surface container -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/colorPrimaryContainer"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/about_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@mipmap/icon"
                android:contentDescription="@string/app_name"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <!-- App Title: a TalkBack heading (API 28+) so swipe-down jumps here. -->
        <TextView
            android:id="@+id/about_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/app_name"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <!-- Version & Offline Badge -->
        <TextView
            android:id="@+id/about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:background="@drawable/badge_chip_background"
            android:textColor="@color/chip_text_section"
            android:elevation="2dp" />

        <!-- Developer Credit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="@string/about_developer"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Highlights Header: heading for TalkBack swipe-down navigation. -->
        <TextView
            android:id="@+id/about_features_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/about_features_header"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <!-- Feature highlights: one view, one TalkBack stop. The text is
             joined from the individual about_feature_* strings in
             TtsSettingsActivity.showAboutDialog() so each line stays
             independently translatable. -->
        <TextView
            android:id="@+id/about_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.25"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <!-- License Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/about_license"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- GitHub Button: outlined (the positive OK button already owns the
             filled/tonal primary slot in the dialog footer). -->
        <Button
            android:id="@+id/btn_about_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:minWidth="160dp"
            android:text="@string/about_view_github"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>