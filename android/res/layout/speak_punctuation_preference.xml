<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/section_gap"
        android:paddingBottom="@dimen/screen_padding" >

        <RadioButton
            android:id="@+id/none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/punctuation_none" />

        <TextView
            android:id="@+id/none_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/section_gap"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/punctuation_none_desc" />

        <RadioButton
            android:id="@+id/some"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/punctuation_some" />

        <TextView
            android:id="@+id/some_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/section_gap"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/punctuation_some_desc" />

        <RadioButton
            android:id="@+id/most"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/punctuation_most" />

        <TextView
            android:id="@+id/most_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/section_gap"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/punctuation_most_desc" />

        <RadioButton
            android:id="@+id/all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/punctuation_all" />

        <TextView
            android:id="@+id/all_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/section_gap"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/punctuation_all_desc" />

        <RadioButton
            android:id="@+id/custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/punctuation_custom" />

        <TextView
            android:id="@+id/custom_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/content_gap"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/punctuation_custom_desc" />

        <!-- Enabled/disabled as a whole (layout + field) tracks the Custom
             radio, so the outline visibly dims with the rest of the control. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/punctuation_characters_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="36dp"
            android:hint="@string/punctuation_characters"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/punctuation_characters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:importantForAutofill="no" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
