  <string name="about_title">About eSpeak NG Advanced</string>
  <string name="about_summary">Version and credits</string>
  <string name="about_body">eSpeak NG Advanced\nVersion %1$s\n\nDeveloped and built by Animesh Ahilya.\n\nBased on eSpeak NG, an open-source formant speech synthesizer, extended with substantially more features - Indian English and Indic language support, Direct-Boot offline reliability, and pronunciation/symbol-reading fixes drawn from NVDA\'s speech engine.\n\nLicensed under the GNU GPL v3 or later.</string>

  <!-- Feature Settings -->
  <string name="setting_indian_numbering">Indian number and currency formatting</string>
  <string name="setting_indian_numbering_summary">Understand Indian-style number grouping like ₹1,00,000, spell out shorthand such as 5L or 2cr as "five lakh" and "two crore", and read UPI IDs and reference numbers digit by digit instead of as one long number</string>
  <string name="setting_programming_symbols">Speak programming and math symbols</string>
  <string name="setting_programming_symbols_summary">Announce code and math symbols (!=, ==, &lt;=, &gt;=, =&gt;, -&gt;, &amp;&amp;, ||) as words</string>
  <string name="setting_smart_codes">Smart OTP and PIN code reading</string>
  <string name="setting_smart_codes_summary">Automatically read verification codes, OTPs, and security PINs digit by digit</string>
  <string name="setting_bilingual_switching">Bilingual script switching</string>
  <string name="setting_bilingual_switching_summary">Pronounce English words in Indic sentences with authentic English phonetics</string>
  <string name="setting_user_dictionary">User dictionary</string>
  <string name="setting_user_dictionary_summary">Add custom word pronunciation and acronym expansion rules (standard .dic syntax)</string>
