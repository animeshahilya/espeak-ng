<?xml version="1.0" encoding="utf-8"?>
<!-- List choices for res/xml/preferences.xml. Entries point at translated
     strings; values must match the constants in VoiceSettings. -->
<resources>
  <string-array name="emoji_processing_entries" translatable="false">
    <item>@string/emoji_announce</item>
    <item>@string/emoji_ignore</item>
  </string-array>
  <string-array name="emoji_processing_values" translatable="false">
    <item>announce</item>
    <item>ignore</item>
  </string-array>

  <!-- The engine treats any value 3+ as "raise pitch by this many Hz" (see
       SpeechSynthesis.Capitals), so the three pitch presets are audibly
       different strengths, not only the barely audible 3Hz minimum. -->
  <string-array name="capitals_entries" translatable="false">
    <item>@string/capitals_pitch</item>
    <item>@string/capitals_pitch_moderate</item>
    <item>@string/capitals_pitch_strong</item>
    <item>@string/capitals_none</item>
    <item>@string/capitals_sound</item>
    <item>@string/capitals_say</item>
  </string-array>
  <string-array name="capitals_values" translatable="false">
    <item>3</item>
    <item>20</item>
    <item>40</item>
    <item>0</item>
    <item>1</item>
    <item>2</item>
  </string-array>

  <string-array name="indian_numbering_entries" translatable="false">
