        <ignore path="src/com/animeshahilya/espeakng/ui/preference/InsetGroupedItemDecoration.java" />
        <ignore path="src/com/animeshahilya/espeakng/ui/SettingsFragment.java" />
        <ignore path="src/com/animeshahilya/espeakng/ui/SettingsBuilder.java" />
    </issue>
    <!-- Sub-screen navigation moves TalkBack focus to the first row on
         purpose: an announcement alone leaves focus on the previous screen. -->
    <issue id="AccessibilityFocus">
        <ignore path="src/com/animeshahilya/espeakng/ui/SettingsFragment.java" />
    </issue>
    <!-- The androidx.startup provider comes from a library (not exported);
         the manifest entry only removes its EmojiCompat initializer. -->
    <issue id="MissingClass">
        <ignore path="AndroidManifest.xml" />
    </issue>
    <issue id="ExportedContentProvider">
        <ignore path="AndroidManifest.xml" />
    </issue>
</lint>
