.group इ
        इ          I
        इ (_       ,i:      // final short i lengthens in Hindi; secondary stress
                             // (not primary) needed so ph_hindi_base's i: phoneme
                             // doesn't self-demote back to plain i when this
                             // syllable isn't the word's own stressed one - see
                             // that phoneme's own isUnstressed guard
        इँ        i~        // + candrabindu
        इं        i~

.group ई
        ई          i:
        ई (_       ,i:      // final -i is always long in Hindi; was plain "i"
                             // (word-final SHORTENING, backwards) before this -
                             // see .group इ above for why the stress mark matters
        ईँ         i~        // + candrabindu

.group उ
        उ          U
        उ (_       u:       // final short u lengthens; no stress mark needed here -
                             // unlike i:, ph_hindi_base's u: has no isUnstressed
                             // self-demotion guard (confirmed by trace: injecting
                             // unstressed u: keeps its own distinct duration)
        उँ         U~        // + candrabindu

